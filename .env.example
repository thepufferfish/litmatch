# =============================================================================
# LitMatch Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] must be set. Others have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (used by the db service in compose.yaml)
# -----------------------------------------------------------------------------
# [REQUIRED] Database name
POSTGRES_DB=bookdb

# [REQUIRED] Database user
POSTGRES_USER=bookuser

# [REQUIRED] Database password -- change this for any shared environment
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# [REQUIRED] Full PostgreSQL connection string
# For compose: use "db" as host (container name). For local dev: use "localhost".
DATABASE_URL=postgresql://bookuser:changeme@db:5432/bookdb

# [REQUIRED] JWT signing key -- generate with: openssl rand -hex 32
SECRET_KEY=changeme

# CORS allowed origins (comma-separated)
# Include both Vite dev server and nginx container origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set to "false" for local development (no TLS)
COOKIE_SECURE=false

# Cookie path for refresh tokens
# Use /api/auth/refresh when accessing via nginx proxy (compose or standalone)
# Use /auth/refresh only for direct backend access without a proxy
REFRESH_COOKIE_PATH=/api/auth/refresh

# -----------------------------------------------------------------------------
# Scraper (Scrapyd)
# -----------------------------------------------------------------------------
# [REQUIRED] Rotating proxy service token
PROXY_TOKEN=your-proxy-token-here

# Scrapyd API URL (used by Dagster to trigger crawl jobs)
# For compose: use "scrapyd" as host (container name). For local dev: use "localhost".
SCRAPYD_URL=http://scrapyd:6800

# -----------------------------------------------------------------------------
# Dagster ETL (container deployment)
# -----------------------------------------------------------------------------
# These are set automatically in compose.yaml; override here if needed.
# RAW_DATA_DIR=/data/raw

# -----------------------------------------------------------------------------
# Recommender (embedding pipeline)
# -----------------------------------------------------------------------------
# Sentence-transformers model for review embeddings (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
