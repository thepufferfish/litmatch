# PostgreSQL
POSTGRES_DB=bookdb
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=bookpassword

# Database connection (used by backend + Dagster)
DATABASE_URL=postgresql://bookuser:bookpassword@localhost:5432/bookdb

# Scraper proxy token
PROXY_TOKEN=your-proxy-token-here

# JWT signing key (REQUIRED - change in production)
SECRET_KEY=change-me-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Auth cookie settings
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/auth/refresh
